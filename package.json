{
  "name": "sipyeong",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "db:migrate": "npm run db:migrate -w @sipyeong/api",
    "db:status": "npm run db:status -w @sipyeong/api",
    "dev": "npm run dev -w @sipyeong/api",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces"
  },
  "dependencies": {
    "dotenv": "^18.0.10"
  }
}
