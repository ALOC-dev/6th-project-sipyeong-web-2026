{
  "name": "sipyeong",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run dev -w @sipyeong/api",
    "dev:web": "npm run dev -w @sipyeong/web",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces --if-present",
    "lint:web": "npm run lint -w @sipyeong/web"
  }
}
