{
  "name": "@sipyeong/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build && node --env-file-if-exists=.env --watch dist/main.js",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11",
    "@nestjs/core": "^11",
    "@nestjs/platform-express": "^11",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^5.9.3"
  }
}
